<h3> Detalle de productos </h3>

<ul id="products">
    {{#each products}}
        <li>
            <strong>{{title}}</strong><br>
            Description: {{description}}<br>
            Code: {{code}}<br>
            Price: ${{price}}<br>
            Category: {{category}}<br>
            <button id="botonAdd"> Agregar a carrito </button>
        </li>
    {{/each}}
</ul>
