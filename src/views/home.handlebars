<h3> Detalle de productos </h3>

<ul id="products">
    {{#each products}}
        <li>
            <strong>{{title}}</strong><br>
            ID: {{_id}}<br>
            Description: {{description}}<br>
            Code: {{code}}<br>
            Price: ${{price}}<br>
            Status: {{status}}<br>
            Stock: {{stock}}<br>
            Category: {{category}}<br>
            Thumbnails: {{thumbnails}}<br>
        </li>
    {{/each}}
</ul>
